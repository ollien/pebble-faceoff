{
  "name": "faceoff",
  "author": "ollien",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10",
    "pebble-fctx": "^1.6.5"
  },
  "pebble": {
    "displayName": "Faceoff",
    "uuid": "b7990d2d-4ea8-4d2c-9b54-603ae7546fee",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "chalk",
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "BACKGROUND_COLOR",
      "TOP_STRIPE_COLOR",
      "BOTTOM_STRIPE_COLOR",
      "FILL_CORNERS",
      "HOUR_COLOR",
      "MINUTE_COLOR",
      "SHOW_DATE",
      "WDAY_COLOR",
      "MDAY_COLOR"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "TIMEFONT",
          "file": "BebasNeue-Regular.ffont"
        }
      ]
    },
    "capabilities": [
      "configurable"
    ]
  },
  "devDependencies": {
    "pebble-fctx-compiler": "^1.2.2"
  }
}
